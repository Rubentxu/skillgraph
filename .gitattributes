# Forzar LF en archivos de texto para evitar CRLF en clones Windows.
* text=auto eol=lf

# Python: indicar que es lenguaje trackable por herramientas (no diff binary).
*.py diff=python

# YAML/Markdown: diffs limpios.
*.yaml diff=yaml
*.yml diff=yaml
*.md diff=markdown

# No tocar permisos ni EOL en binarios.
*.png binary
*.jpg binary
*.webp binary
*.ico binary
*.woff2 binary
*.zip binary
*.whl binary
*.tar.gz binary